// Approach 2: CI/CD Pipeline using Docker Container Packaging & AWS ECR/ECS
def COLOR_MAP = [
    'SUCCESS': 'good', 
    'FAILURE': 'danger',
    'UNSTABLE': 'warning',
    'ABORTED': '#808080'
]
def dockerImage

pipeline {
    agent any

    environment {
        registryCredential = 'ecr:us-east-1:Jenkins_aws_login'
        appRegistry        = "667836586343.dkr.ecr.us-east-1.amazonaws.com/attendance-salary-app"
        attendanceRegistry = "https://667836586343.dkr.ecr.us-east-1.amazonaws.com"
        cluster            = "attendance-cluster-prod"
        service            = "attendance-service"
        AWS_REGION         = "us-east-1"
    }

    stages {
        stage('Run Tests') {
            steps {
                echo 'Running automated tests before containerization...'
                sh 'npm test'
            }
        }

        stage('Sonar Code Analysis') {
            environment {
                scannerHome = tool 'Sonar8.0'
            }
            steps {
                echo 'Running SonarQube Code Quality and Security Analysis...'
                withSonarQubeEnv('Sonar-server') {
                    sh '''${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=attendance-salary-app \
                        -Dsonar.projectName=attendance-salary-app \
                        -Dsonar.projectVersion=1.0 \
                        -Dsonar.sources=. \
                        -Dsonar.exclusions=node_modules/**,*.tgz \
                        -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                        -Dsonar.eslint.reportPaths=eslint-report.json 
                        '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo 'Checking SonarQube Quality Gate Status...'
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker container image: ${appRegistry}:${BUILD_NUMBER}-${BUILD_TIMESTAMP}..."
                    dockerImage = docker.build("${appRegistry}:${BUILD_NUMBER}-${BUILD_TIMESTAMP}", ".")
                }
            }
        }

        stage('Push Image to AWS ECR') {
            steps {
                script {
                    echo 'Authenticating and pushing container image to AWS ECR...'
                    docker.withRegistry(vprofileRegistry, registryCredential) {
                        dockerImage.push("${BUILD_NUMBER}-${BUILD_TIMESTAMP}")
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Deploy to AWS ECS') {
            steps {
                withAWS(credentials: 'Jenkins_aws_login', region: "${AWS_REGION}") {
                    script {
                        echo 'Fetching current ECS Task Definition...'
                        def currentTaskDefArn = sh(
                            script: "aws ecs describe-services --cluster ${cluster} --services ${service} --query 'services[0].taskDefinition' --output text",
                            returnStdout: true
                        ).trim()

                        echo "Registering new Task Definition revision with image ${appRegistry}:${BUILD_NUMBER}-${BUILD_TIMESTAMP}..."
                        def newTaskDefArn = sh(
                            script: """
                                aws ecs describe-task-definition --task-definition ${currentTaskDefArn} --query 'taskDefinition' | \
                                jq '.containerDefinitions[0].image="${appRegistry}:${BUILD_NUMBER}-${BUILD_TIMESTAMP}" | del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy)' > updated-task-def.json
                                aws ecs register-task-definition --cli-input-json file://updated-task-def.json --query 'taskDefinition.taskDefinitionArn' --output text
                            """,
                            returnStdout: true
                        ).trim()

                        echo "Updating ECS Service with new Task Definition: ${newTaskDefArn}..."
                        sh "aws ecs update-service --cluster ${cluster} --service ${service} --task-definition ${newTaskDefArn}"

                        echo 'Waiting for ECS rolling deployment to stabilize...'
                        sh "aws ecs wait services-stable --cluster ${cluster} --services ${service}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up local docker images on Jenkins host...'
            sh "docker rmi -f ${appRegistry}:${BUILD_NUMBER}-${BUILD_TIMESTAMP} ${appRegistry}:latest || true"
            sh 'docker image prune -f || true'

            echo 'Sending Slack build notification...'
            slackSend channel: '#jenkins-ci',
                color: COLOR_MAP[currentBuild.currentResult] ?: 'good',
                message: "*${currentBuild.currentResult}:* Job ${env.JOB_NAME} build ${env.BUILD_NUMBER} \n More info at: ${env.BUILD_URL}"
        }
    }
}
